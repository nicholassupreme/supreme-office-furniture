# Postgres connection string (Neon / Supabase free tier). Use the POOLED connection string if offered.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Long random string, at least 32 characters. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# The public address of the site (no trailing slash)
BETTER_AUTH_URL=https://www.supreme.com.my

# Optional: Google login. Leave all three out to hide the Google button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_LOGIN=1
